# Copy to local.properties for machine-specific paths and signing credentials.
# Use forward slashes in Windows paths. Existing local.properties may contain passwords.
# Android Studio also writes sdk.dir. ANDROID_HOME or ANDROID_SDK_ROOT can supply it.
# sdk.dir=C:/Users/<you>/AppData/Local/Android/Sdk

# Optional Rust overrides. Cargo is discovered from PATH, then CARGO_HOME/bin or ~/.cargo/bin.
# rust.cargo=C:/Users/<you>/.cargo/bin/cargo.exe
# rust.path=C:/custom/tool/bin;C:/Windows/System32;C:/Windows

# Optional libclang directory. Otherwise use LIBCLANG_PATH, then the selected NDK.
# rust.libclang=C:/Program Files/LLVM/bin

# Optional release signing. Supply all four values to use a release keystore.
# Paths are relative to the repository root or absolute.
# RELEASE_STORE_FILE=key/folia-rust.jks
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=folia-rust
# RELEASE_KEY_PASSWORD=
